generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id      String        @id @default(uuid())
  size    String 
  type    String 
  owner   String 
  Fridge  Fridge[]
  Recipe  Recipe[]

  @@map("products")       
}

model Fridge {
  id        String      @id @default(uuid())
  location  String
  capacity  String
  products  Product[]

  @@map("fridges")
}

model Recipe {
  id          String      @id @default(uuid())
  name        String      
  description String
  owner       String
  ingredients Product[]

  @@map("recipes")
}
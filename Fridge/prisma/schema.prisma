generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum ProductType {
  Food
  Drink
}
model Product {
  id        String        @id @default(uuid())
  size      Int 
  type      ProductType 
  owner     String 
  fridgeId  String? 
  fridge    Fridge?       @relation(fields: [fridgeId], references: [id])
  recipe    Recipe[]        

  @@map("products")       
}

model Fridge {
  id        String      @id @default(uuid())
  location  Int
  capacity  Int
  products  Product[]

  @@map("fridges")
}

model Recipe {
  id          String      @id @default(uuid())
  name        String      
  description String
  owner       String
  ingredients Product[]

  @@map("recipes")
}